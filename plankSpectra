import numpy as np
import matplotlib.pyplot as plt
import pandas as pd

# Constants

h = 6.62607015e-34
c = 2.99792458e8
kB = 1.380649e-23

# Earth and Sun Values

R_sun = 6.957e8 
D = 149597870700 
albedo = 0.296
T_sun = 5770

# Equations irradiance

def spec_rad_F(f, T):
    k = (2 * h * f**3) / (c**2)
    return k * (1 / (np.exp((h * f)/(kB * T))-1))

def irradiance_E(f, T=T_sun):
    return np.pi * (R_sun / D)**2 * spec_rad_F(f, T)

#Frequency Values

f = np.logspace(11, 15.5, 20000)

#Converting Units

lam = c / f  
def to_per_um(I_nu):
    return I_nu * (c / lam**2) * 1e-6

#Energy Balance

def absorbed_power(S):
    return (1 - albedo) * S / 4

def emitted_power(T):             
    flux = np.pi * spec_rad_F(f, T)                 
    return np.trapezoid(flux, f)

#Sum the area under the curve for the incoming Planck prediction

S_planck = np.trapezoid(irradiance_E(f), f)

#FINDING T that balances incoming and outgoing

T = 200.0         
step = 10.0        
absorbed = absorbed_power(S_planck)

for i in range(200):
    diff = absorbed - emitted_power(T)

    if abs(diff) < 1e-6:      
        break

    if diff > 0:               
        T = T + step
    else:                       
        T = T - step
        step = step / 2         

print("T_earth:", T)
T_earth = T

#e490 setup

e490 = pd.read_csv("e490_00a_amo.csv", usecols=[0, 1], header=0)
e490.columns = ["wavelength_um", "irradiance"]
e490 = e490.apply(pd.to_numeric, errors="coerce").dropna()

I_sun = irradiance_E(f)
I_earth = np.pi * spec_rad_F(f, T_earth)
I_sun_lam = to_per_um(I_sun)
I_earth_lam = to_per_um(I_earth)

#Sum the area under the curve for E90, and Emitted Power

S_e490 = np.trapezoid(e490["irradiance"], e490["wavelength_um"])
S_out = emitted_power(T_earth)

#Plots 4 plots tables

fig, ax = plt.subplots(2, 2, figsize=(12, 8))

titles = [["Frequency, linear", "Wavelength, linear"],
          ["Frequency, log-log", "Wavelength, log-log"]]

for row in range(2):
    a = ax[row, 0]
    b = ax[row, 1]
    b.plot(e490["wavelength_um"], e490["irradiance"], color="green", lw=1.5, label="E490 Data")
    a.plot(f / 1e12, I_sun, color="orange", lw=1.5, label="Sun")
    a.plot(f / 1e12, I_earth, color="tab:blue", lw=1.5, label="Earth")
    b.plot(lam * 1e6, I_sun_lam, color="orange", lw=1.5, label="Sun")
    b.plot(lam * 1e6, I_earth_lam, color="tab:blue", lw=1.5, label="Earth")
   

    a.set_xlabel("Frequency (THz)")
    a.set_ylabel("Iradiation (W m$^{-2}$ Hz$^{-1}$)")
    b.set_xlabel("Wavelength ($\\mu$m)")
    b.set_ylabel("Iradiation (W m$^{-2}$ $\\mu$m$^{-1}$)")
    a.set_title(titles[row][0], fontsize=10)
    b.set_title(titles[row][1], fontsize=10)

    if row == 0:
        a.set_xlim(0, 1500)
        b.set_xlim(0, 3)
    else:
        for axis in (a, b):
            axis.set_xscale("log")
            axis.set_yscale("log")
        a.set_ylim(1e-20, 1e-9)
        b.set_ylim(1e-6, 1e4)

    for axis in (a, b):
        axis.grid(alpha=0.3)
    a.legend(fontsize=8)
    b.legend(fontsize=8)

plt.tight_layout(rect=[0, 0.12, 1, 1]) 
plt.figtext(0.5, 0.11, "Sun and Earth Planck spectra with E490 data.",  ha="center")
plt.figtext(0.5, 0.06," The incoming Planck prediction is " + str(S_planck) + ". The E490 is " + str(S_e490) + ". The outgoing Planck prediction is " + str(S_out) , ha="center")
plt.figtext(0.5, 0.01, "The predicted temperature is " + str(T_earth),  ha="center")
plt.show()