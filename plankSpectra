S_lines = hitran["S"].values
gamma_lines = hitran["gamma_air"].values

#Lorentzian

nu_grid = np.linspace(450, 850, 40000, endpoint=False)    # step 0.01 cm^-1

def cross_section(nu_grid, p=1.0):
    #making a grid
    sigma = np.zeros_like(nu_grid)

    #Looping Over every line
    for i in range(len(nu_lines)):
        gamma = gamma_lines[i] * p
        sigma += S_lines[i] / np.pi * gamma / (gamma**2 + (nu_grid - nu_lines[i])**2)
    return sigma

sigma_1 = cross_section(nu_grid, 1)

