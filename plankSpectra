#NUMBER 3

g = 9.81                       # m/s^2
m_air = 28.97 * 1.66054e-27    # mass of ONE air molecule (kg)
P0 = 101325.0                  # surface pressure (Pa)
Gamma = 0.00649                # lapse rate (K/m)
eta = 0.75

f_band = c_cm * nu_grid        # Hz (c_cm is cm/s because nu_grid is in cm^-1

def outgoing_band(Ts, ppm, sigma):
    N0 = ppm * 1e-6 * P0 / (kB * Ts)        
    z0 = kB * Ts / (m_air * g)              
    Ttrop = Ts - Gamma * z0 * np.log(1 + eta)

    OD = N0 * (sigma * 1e-4) * z0          

    B_s = spec_rad_F(f_band, Ts)
    B_t = spec_rad_F(f_band, Ttrop)
    return B_s * np.exp(-OD) + B_t * (1 - np.exp(-OD))

def emitted_power_co2(Ts, ppm, sigma):
    full = np.pi * np.trapezoid(spec_rad_F(f, Ts), f)                      # whole spectrum, no CO2
    band_plain = np.pi * np.trapezoid(spec_rad_F(f_band, Ts), f_band)      # band, no CO2
    band_co2 = np.pi * np.trapezoid(outgoing_band(Ts, ppm, sigma), f_band) # band, with CO2
    return full - band_plain + band_co2

def find_T(ppm, sigma):
    T = 200.0
    step = 10.0
    for i in range(500):
        diff = absorbed - emitted_power_co2(T, ppm, sigma)
        if abs(diff) < 1e-6:
            break
        if diff > 0:
            T = T + step
        else:
            T = T - step
            step = step / 2
    return T

T_0 = find_T(0, sigma_1)
T_350 = find_T(350, sigma_1)
T_426_10 = find_T(426.10, sigma_1)

