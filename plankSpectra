def outgoing_band(Ts, ppm, sigma):
    N0 = ppm * 1e-6 * P0 / (kB * Ts)        
    z0 = kB * Ts / (m_air * g)              
    Tstrat = Ts + Gamma * z0 * np.log(1 - eta)
    print(Tstrat)
    OD = N0 * (sigma * 1e-4) * z0          

    B_s = spec_rad_F(f_band, Ts)
    B_t = spec_rad_F(f_band, Tstrat)
    return B_s * np.exp(-OD) + B_t * (1 - np.exp(-OD))

def emitted_power_co2(Ts, ppm, sigma):
    full = np.pi * np.trapezoid(spec_rad_F(f, Ts), f)                     
    band_plain = np.pi * np.trapezoid(spec_rad_F(f_band, Ts), f_band)      # no c02
    band_co2 = np.pi * np.trapezoid(outgoing_band(Ts, ppm, sigma), f_band) # with CO2
    return full - band_plain + band_co2

def find_T(ppm, sigma):
    T = 200.0
    step = 10.0
    for i in range(500):
        diff = absorbed - emitted_power_co2(T, ppm, sigma)
        if abs(diff) < 1e-6:
            break
        if diff > 0:
            T = T + step
        else:
            T = T - step
            step = step / 2
    return T

