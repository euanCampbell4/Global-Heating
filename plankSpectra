import numpy as np
import matplotlib.pyplot as plt
import pandas as pd

# Constants

h = 6.62607015e-34
c = 2.99792458e8
kB = 1.380649e-23

# Earth and Sun Values

R_sun = 6.957e8 
D = 149597870700 
albedo = 0.296
T_sun = 5770

# Equations irradiance

def spec_rad_F(f, T):
    k = (2 * h * f**3) / (c**2)
    return k * (1 / (np.exp((h * f)/(kB * T))-1))

def irradiance_E(f, T=T_sun):
    return np.pi * (R_sun / D)**2 * spec_rad_F(f, T)

#Frequency Values

f = np.logspace(11, 15.5, 20000)

#Converting Units

lam = c / f  
def to_per_um(I_nu):
    return I_nu * (c / lam**2) * 1e-6

#Energy Balance

def absorbed_power(S):
    return (1 - albedo) * S / 4

def emitted_power(T):             
    flux = np.pi * spec_rad_F(f, T)                 
    return np.trapezoid(flux, f)

#Sum the area under the curve for the incoming Planck prediction

S_planck = np.trapezoid(irradiance_E(f), f)

#FINDING T that balances incoming and outgoing

T = 200.0         
step = 10.0        
absorbed = absorbed_power(S_planck)

for i in range(200):
    diff = absorbed - emitted_power(T)

    if abs(diff) < 1e-6:      
        break

    if diff > 0:               
        T = T + step
    else:                       
        T = T - step
        step = step / 2         

print("T_earth:", T)
T_earth = T

#e490 setup

e490 = pd.read_csv("e490_00a_amo.csv", usecols=[0, 1], header=0)
e490.columns = ["wavelength_um", "irradiance"]
e490 = e490.apply(pd.to_numeric, errors="coerce").dropna()

I_sun = irradiance_E(f)
I_earth = np.pi * spec_rad_F(f, T_earth)
I_sun_lam = to_per_um(I_sun)
I_earth_lam = to_per_um(I_earth)

#Sum the area under the curve for E90, and Emitted Power

S_e490 = np.trapezoid(e490["irradiance"], e490["wavelength_um"])
S_out = emitted_power(T_earth)

#Plots 4 plots tables

fig, ax = plt.subplots(2, 2, figsize=(12, 8))

titles = [["Frequency, linear", "Wavelength, linear"],
          ["Frequency, log-log", "Wavelength, log-log"]]

for row in range(2):
    a = ax[row, 0]
    b = ax[row, 1]
    b.plot(e490["wavelength_um"], e490["irradiance"], color="green", lw=1.5, label="E490 Data")
    a.plot(f / 1e12, I_sun, color="orange", lw=1.5, label="Sun")
    a.plot(f / 1e12, I_earth, color="tab:blue", lw=1.5, label="Earth")
    b.plot(lam * 1e6, I_sun_lam, color="orange", lw=1.5, label="Sun")
    b.plot(lam * 1e6, I_earth_lam, color="tab:blue", lw=1.5, label="Earth")
   

    a.set_xlabel("Frequency (THz)")
    a.set_ylabel("Iradiation (W m$^{-2}$ Hz$^{-1}$)")
    b.set_xlabel("Wavelength ($\\mu$m)")
    b.set_ylabel("Iradiation (W m$^{-2}$ $\\mu$m$^{-1}$)")
    a.set_title(titles[row][0], fontsize=10)
    b.set_title(titles[row][1], fontsize=10)

    if row == 0:
        a.set_xlim(0, 1500)
        b.set_xlim(0, 3)
    else:
        for axis in (a, b):
            axis.set_xscale("log")
            axis.set_yscale("log")
        a.set_ylim(1e-20, 1e-9)
        b.set_ylim(1e-6, 1e4)

    for axis in (a, b):
        axis.grid(alpha=0.3)
    a.legend(fontsize=8)
    b.legend(fontsize=8)

plt.tight_layout(rect=[0, 0.12, 1, 1]) 
plt.figtext(0.5, 0.11, "Sun and Earth Planck spectra with E490 data.",  ha="center")
plt.figtext(0.5, 0.06," The incoming Planck prediction is " + str(S_planck) + ". The E490 is " + str(S_e490) + ". The outgoing Planck prediction is " + str(S_out) , ha="center")
plt.figtext(0.5, 0.01, "The predicted temperature is " + str(T_earth),  ha="center")
plt.show()

#Plotting HITRAN DATA
hitran = pd.read_csv("CO2Min.csv", usecols=[0, 1, 2], header=0)
hitran.columns = ["nu", "S", "gamma_air"]

nu_lines = hitran["nu"].values
S_lines = hitran["S"].values
gamma_lines = hitran["gamma_air"].values

plt.figure(figsize=(10, 4))
plt.vlines(nu_lines, 1e-32, S_lines, lw=0.5)
plt.yscale("log")
plt.xlim(570, 770)
plt.ylim(1e-32, S_lines.max() * 3)
plt.xlabel("Wavenumber (cm$^{-1}$)")
plt.ylabel("Line strength S (cm$^{-1}$/(molecule cm$^{-2}$))")
plt.show()

#Lorentzian

nu_grid = np.linspace(450, 850, 40000, endpoint=False)    # step 0.005 cm^-1

def cross_section(nu_grid, p=1.0):
    #making a grid
    sigma = np.zeros_like(nu_grid)

    #Looping Over every line
    for i in range(len(nu_lines)):
        gamma = gamma_lines[i] * p
        sigma += S_lines[i] / np.pi * gamma / (gamma**2 + (nu_grid - nu_lines[i])**2)
    return sigma

sigma_1 = cross_section(nu_grid, 1)

fig, ax = plt.subplots(1, 2, figsize=(11, 4))
ax[0].semilogy(nu_grid, sigma_1)
ax[0].set_xlabel("Wavenumber (cm$^{-1}$)")
ax[0].set_ylabel("Cross-section (cm$^2$)")

ax[1].semilogy(nu_grid, sigma_1, label="1 atm")
ax[1].set_xlim(680, 695)
ax[1].set_xlabel("Wavenumber (cm$^{-1}$)")
ax[1].legend()

plt.tight_layout()
plt.show()

#CHANGE TO FREQUENCY

c_cm = 2.99792458e10             # speed of light in cm/s

def to_THz(nu_cm):
    return nu_cm * c_cm / 1e12   # cm^-1 -> THz

# average over 2 cm^-1 bins (400 grid points each) so we fit the envelope, not single lines
sigma_bin = sigma_1.reshape(-1, 400).mean(axis=1)
nu_bin = nu_grid.reshape(-1, 400).mean(axis=1)

nu_c = 667.4

right = (nu_bin > nu_c + 10) & (nu_bin < 750)
left = (nu_bin < nu_c - 10) & (nu_bin > 590)

m_r, b_r = np.polyfit(nu_bin[right], np.log(sigma_bin[right]), 1)
m_l, b_l = np.polyfit(nu_bin[left], np.log(sigma_bin[left]), 1)

plt.figure(figsize=(10, 5))


plt.semilogy(to_THz(nu_grid), sigma_1, color="tab:red", lw=0.5, alpha=0.6, label="1 atm")
plt.semilogy(to_THz(nu_bin[right]), np.exp(b_r + m_r * nu_bin[right]), color="orange", lw=2, label="fit, high side")
plt.semilogy(to_THz(nu_bin[left]), np.exp(b_l + m_l * nu_bin[left]), color="blue", lw=2, label="fit, low side")
plt.semilogy(to_THz(nu_lines), S_lines, ".", color="indigo", ms=3, label="HITRAN S")

plt.xlim(to_THz(570), to_THz(770))     # about 17.1 to 23.1 THz
plt.ylim(1e-22, 1e-17)
plt.xlabel("Frequency (THz)")
plt.ylabel("Cross-section (cm$^2$)")
plt.legend(fontsize=8)
plt.grid(alpha=0.3)
plt.show()